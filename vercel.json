{
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["src/**", "templates/**"]
      }
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ]
}
